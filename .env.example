# COZ CASTLE Frontend - Environment Variables Template
# Copy this file to .env.development or .env.production and configure

# ================================
# API Configuration
# ================================
# Backend API base URL
# Development: http://localhost:3001
# Production: https://www.cozcastle.com (or relative URL if served from same domain)
VITE_API_BASE_URL=http://localhost:3001

# ================================
# App Configuration
# ================================
# Application mode (development or production)
VITE_APP_MODE=development

# ================================
# IMPORTANT NOTES:
# ================================
# 1. All environment variables must be prefixed with VITE_ to be accessible in the browser
# 2. Never commit .env files to version control (they're in .gitignore)
# 3. Backend CORS must allow the frontend origin:
#    - Development: http://localhost:5173
#    - Production: https://www.cozcastle.com
# 4. After changing env files, restart the dev server for changes to take effect
